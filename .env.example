APP_NAME=NexaDesk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:92
# Teks kecil di bawah nama aplikasi pada sidebar (opsional).
# APP_SLOGAN=

# daily = satu berkas log per hari, otomatis dibuang setelah 14 hari
# (lihat 'days' pada config/logging.php).
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB_HOST=mariadb adalah nama service di docker-compose.yml.
# DB_USERNAME tidak boleh "root": image MariaDB menolaknya untuk MYSQL_USER.
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=nexadesk
DB_USERNAME=administrator
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Docker (docker-compose.yml). Nama container: <SUFFIX_APP_NAME>-app, -mariadb, -webserver.
SUFFIX_APP_NAME=nexadesk

# Isi dengan hasil `id -un`, `id -u`, `id -g`, `id -gn` di WSL supaya berkas
# yang dibuat dari dalam container tetap milik user Anda.
USER=
UID=1000
GID=1000
GROUP=

MARIADB_EXPOSE_PORT=3312
NGINX_EXPOSE_PORT=92
NGINX_SSL_EXPOSE_PORT=452
